# .env.example - Local environment variables template
# NOTE: Real secrets are never committed to git. Load them at runtime from the
# existing Azure Key Vault `dp-kv-deliverypilot` — do not create a new vault.
# See 2_Environment/setup_azure.md and .kilo/skills/secrets.md.

# --- AZURE KEY VAULT CONFIGURATION ---
AZURE_KEYVAULT_NAME="dp-kv-deliverypilot"
AZURE_TENANT_ID="your-azure-tenant-id"
AZURE_CLIENT_ID="your-service-principal-client-id"
AZURE_CLIENT_SECRET="your-service-principal-client-secret"

# --- AI MODEL PROVIDER API KEYS (PULLED FROM KEY VAULT AT RUNTIME) ---
# Key Vault secret name -> local env var
ANTHROPIC_API_KEY="from-vault:ANTHROPIC-API-KEY"
OPENAI_API_KEY="from-vault:OPENAI-API-KEY"
GEMINI_API_KEY_PRIMARY="from-vault:GEMINI-API-KEY-PRIMARY"
GEMINI_API_KEY_SECONDARY="from-vault:GEMINI-API-KEY-SECONDARY"
GOOGLE_IMAGEN_API_KEY="from-vault:GOOGLE-IMAGEN-API-KEY"
FAL_AI_KEY="from-vault:FAL-AI-KEY"

# --- YOUTUBE / VIDEO PRODUCTION ---
YOUTUBE_API_KEY="from-vault:YOUTUBE-API-KEY"

# --- GOOGLE OAUTH (Drive, Calendar, etc.) ---
GOOGLE_OAUTH_CLIENT_ID="from-vault:google-oauth-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="from-vault:google-oauth-client-secret"
GOOGLE_OAUTH_REFRESH_TOKEN="from-vault:google-oauth-refresh-token"

# --- CANVA MCP ---
CANVA_CLIENT_ID="from-vault:canva-mcp-CANVA-CLIENT-ID"
CANVA_CLIENT_SECRET="from-vault:canva-mcp-CANVA-CLIENT-SECRET"

# --- OPTIONAL: SERVER-SIDE LOGS (only if this project grows a backend) ---
AXIOM_TOKEN="from-vault:AXIOM-TOKEN"
AXIOM_DATASET="video-asistant-dev"
